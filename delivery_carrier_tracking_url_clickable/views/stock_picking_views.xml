<odoo>
  <record id="view_picking_form_inherit_tracking_url" model="ir.ui.view">
    <field name="name">stock.picking.form.inherit.tracking.url</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='carrier_tracking_ref']" position="after">
        <field name="tracking_url_clickable" readonly="1" />
      </xpath>
    </field>
  </record>
</odoo>
